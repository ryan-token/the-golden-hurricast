# Copy to .env (gitignored) and fill in.

# Hurricast API (serverless/), e.g. the dev stage's API Gateway URL.
HURRICAST_API_URL=https://xxxxxxxxxx.execute-api.us-east-2.amazonaws.com
# Shared key for that stage (SSM: /hurricast/<stage>/site-api-key), 32+ characters.
HURRICAST_API_KEY=

# Serverless Framework access key for the thegoldenhurricast org (used by .envrc / direnv).
SERVERLESS_ACCESS_KEY=
