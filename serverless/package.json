{
	"name": "hurricast-api",
	"private": true,
	"version": "1.0.0",
	"description": "AWS backend for thegoldenhurricast.com: merch catalog, inventory, Stripe checkout and fulfillment, listener questions",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"check": "tsc --noEmit",
		"lint": "eslint .",
		"test": "vitest --run",
		"deploy:dev": "npm run check && npm test && npm run verify:bundle && serverless deploy --stage dev",
		"deploy:prod": "npm run check && npm test && serverless package --stage prod && node scripts/verify-bundle.ts && serverless deploy --stage prod",
		"inventory": "node scripts/inventory.ts",
		"orders": "node scripts/orders.ts",
		"seed-inventory": "node scripts/seed-inventory.ts",
		"verify:bundle": "serverless package --stage dev && node scripts/verify-bundle.ts"
	},
	"imports": {
		"#src/*": "./src/*"
	},
	"dependencies": {
		"stripe": "^23.0.0",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@aws-sdk/client-dynamodb": "^3.1146.0",
		"@aws-sdk/client-ssm": "^3.1146.0",
		"@aws-sdk/lib-dynamodb": "^3.1146.0",
		"@aws-sdk/util-dynamodb": "^3.996.9",
		"@eslint/js": "^10.0.1",
		"@types/aws-lambda": "^8.10.164",
		"@types/node": "^24.19.1",
		"eslint": "^10.12.0",
		"globals": "^17.13.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0",
		"vitest": "^4.1.11"
	}
}
